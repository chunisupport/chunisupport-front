# ハッシュなしの HTML、version.json、manifest.webmanifest、ogp.png、
# apple-touch-icon.png、pwa-icon-*.png などは既定のキャッシュのままにする。

/version.json
  Cache-Control: no-store

# ファイル名にコンテンツハッシュを含むビルド成果物。
# dist/static 配下の js / css / woff2 / svg / image / *.js.LICENSE.txt が対象。
# フォント CSS と woff2 もこの規則に載せ、HTML へインラインしない。
# /static/fonts/<family>/OFL.txt も同じ規則に含まれる。キャッシュ規則自体は変えない。
/static/*
  Cache-Control: public, max-age=31536000, immutable

# output.copy で付与するハッシュ付き favicon（favicon.<hash>.png）。
/favicon.*.png
  Cache-Control: public, max-age=31536000, immutable
